{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build.ts",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/fhir/:path*", "destination": "/api/fhir/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
